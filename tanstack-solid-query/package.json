{
  "name": "@trpc/tanstack-solid-query",
  "version": "11.17.0",
  "description": "TanStack Solid Query Integration for tRPC",
  "keywords": [
    "solid-js",
    "tanstack-query",
    "trpc"
  ],
  "license": "MIT",
  "author": "kirill-dev-pro",
  "files": [
    "dist",
    "src",
    "README.md",
    "package.json"
  ],
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint --cache src",
    "typecheck": "tsc --noEmit --preserveWatchOutput --pretty",
    "test": "vitest run"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@tanstack/solid-query": "^5.100.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@trpc/client": "11.17.0",
    "@trpc/server": "11.17.0",
    "@types/node": "^22.13.5",
    "eslint": "^9.26.0",
    "event-source-polyfill": "^1.0.31",
    "jsdom": "^26.1.0",
    "konn": "^0.7.0",
    "solid-js": "^1.9.12",
    "tsdown": "0.12.7",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^4.0.18",
    "ws": "^8.0.0",
    "zod": "^4.2.1"
  },
  "peerDependencies": {
    "@tanstack/solid-query": "^5.80.3",
    "@trpc/client": "11.17.0",
    "@trpc/server": "11.17.0",
    "solid-js": "^1.9.0",
    "typescript": ">=5.7.2"
  }
}
